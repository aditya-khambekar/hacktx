# Copy these entries into .env.local for Next.js and the pricing importer; the seed command reads .env.
# Do not commit either file or paste the token in chat.
SNOWFLAKE_ACCOUNT_HOST=your-org-your-account.snowflakecomputing.com
SNOWFLAKE_TOKEN=replace-locally
SNOWFLAKE_TOKEN_TYPE=PROGRAMMATIC_ACCESS_TOKEN
SNOWFLAKE_DATABASE=UNLISTED
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=UNLISTED_APP
